{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Number Lookup"
      },
      "description": "Live intelligence for ONE North American phone number: current carrier of record, line type, LRN routing data, porting activation date, and optionally caller-ID name (cnam), spam reputation, and messaging provider. Always a fresh read of live numbering infrastructure \u2014 never cached carrier data.",
      "inputSchema": {
        "properties": {
          "phone_number": {
            "description": "US/Canada number, any common format",
            "type": "string"
          },
          "products": {
            "description": "Data sets to include. Default ['lrn'] (carrier/line-type/routing).",
            "items": {
              "enum": [
                "lrn",
                "cnam",
                "spam",
                "messaging"
              ],
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "phone_number"
        ],
        "type": "object"
      },
      "name": "vri_number_lookup",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Lookup result for the number",
        "properties": {
          "billed": {
            "description": "Whether this lookup was charged",
            "type": "boolean"
          },
          "data": {
            "additionalProperties": true,
            "description": "Carrier, line type, LRN, and any requested cnam/spam/messaging fields",
            "type": "object"
          },
          "phone_number": {
            "description": "Normalized number",
            "type": "string"
          },
          "status": {
            "description": "success or error",
            "type": "string"
          }
        },
        "type": "object"
      },
      "title": "Number Lookup"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Spam Check"
      },
      "description": "Spam/scam/robocall reputation for one North American phone number.",
      "inputSchema": {
        "properties": {
          "phone_number": {
            "description": "US/Canada number, any common format",
            "type": "string"
          }
        },
        "required": [
          "phone_number"
        ],
        "type": "object"
      },
      "name": "vri_spam_check",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Spam reputation verdict",
        "properties": {
          "is_spam": {
            "description": "True if flagged spam/scam/robocall",
            "type": "boolean"
          },
          "phone_number": {
            "type": "string"
          },
          "spam_type": {
            "description": "SCAM, ROBOCALL, or null when clean",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "title": "Spam Check"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Bulk Job Status"
      },
      "description": "Status and progress of a VRI bulk lookup job by job id.",
      "inputSchema": {
        "properties": {
          "job_id": {
            "description": "Job id returned by vri_bulk_lookup or vri_submit_job",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "type": "object"
      },
      "name": "vri_bulk_status",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Job status snapshot",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "processed": {
            "description": "Numbers completed so far",
            "type": "integer"
          },
          "status": {
            "description": "Job state, e.g. RUNNING or COMPLETED",
            "type": "string"
          }
        },
        "type": "object"
      },
      "title": "Bulk Job Status"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Bulk Lookup"
      },
      "description": "Live lookup for up to 100 North American phone numbers in one call (carrier, line type, routing; optional cnam/spam/messaging). Each number is a fresh paid read \u2014 spend scope required.",
      "inputSchema": {
        "properties": {
          "phone_numbers": {
            "description": "US/Canada numbers, any common format (max 100)",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "type": "array"
          },
          "products": {
            "description": "Data sets per number. Default ['lrn'].",
            "items": {
              "enum": [
                "lrn",
                "cnam",
                "spam",
                "messaging"
              ],
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "phone_numbers"
        ],
        "type": "object"
      },
      "name": "vri_bulk_lookup",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Per-number results plus total charged",
        "properties": {
          "results": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "total_charged": {
            "description": "USD amount billed for this call",
            "type": "string"
          }
        },
        "type": "object"
      },
      "title": "Bulk Lookup"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "SMS Deliverability Check"
      },
      "description": "ONE verdict for AI outreach: can this North American number receive SMS, and is now a reasonable time to send? Returns sms_capable (live line-type read), VoIP flag, spam reputation, the recipient's approximate local time with an 8am-9pm calling-window flag, and plain-language reasons. Deliverability and reputation signals only \u2014 not a legal compliance determination (no DNC/reassigned-number/litigator data).",
      "inputSchema": {
        "properties": {
          "phone_number": {
            "description": "US/Canada number, any common format",
            "type": "string"
          }
        },
        "required": [
          "phone_number"
        ],
        "type": "object"
      },
      "name": "vri_sms_deliverability",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Deliverability verdict",
        "properties": {
          "line_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "ok_to_message_now": {
            "description": "sms_capable AND clean AND inside the calling window",
            "type": "boolean"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "recipient_local": {
            "description": "Approximate timezone, local_time, quiet_hours_ok",
            "type": [
              "object",
              "null"
            ]
          },
          "sms_capable": {
            "description": "Wireless line that can receive SMS",
            "type": "boolean"
          },
          "spam_flagged": {
            "type": "boolean"
          },
          "voip": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "title": "SMS Deliverability Check"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Submit Async Job"
      },
      "description": "Submit an ASYNC bulk lookup job for up to 10000 North American phone numbers. Balance is reserved up front and the job runs in the background; check progress with vri_bulk_status. Requires a customer API key (jobs bill the account that owns the key).",
      "inputSchema": {
        "properties": {
          "phone_numbers": {
            "description": "US/Canada numbers to process asynchronously (max 10000)",
            "items": {
              "type": "string"
            },
            "maxItems": 10000,
            "type": "array"
          },
          "products": {
            "description": "Default ['lrn'].",
            "items": {
              "enum": [
                "lrn",
                "cnam",
                "spam",
                "messaging"
              ],
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "phone_numbers"
        ],
        "type": "object"
      },
      "name": "vri_submit_job",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Accepted job receipt",
        "properties": {
          "job_id": {
            "description": "Use with vri_bulk_status",
            "type": "string"
          },
          "reserved": {
            "description": "USD balance reserved for the job",
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "title": "Submit Async Job"
    }
  ]
}